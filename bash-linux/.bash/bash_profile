# Interactive helpers shared by Bash and Zsh. Every fragment is optional so a
# partially provisioned machine still gets a usable shell.
for dotfiles_fragment in bash_aliases fzf_related utilities google_cloud k8s; do
  [ -r "$HOME/.bash/$dotfiles_fragment" ] && . "$HOME/.bash/$dotfiles_fragment"
done
unset dotfiles_fragment

if [ -n "${BASH_VERSION:-}" ]; then
  set -o vi
elif [ -n "${ZSH_VERSION:-}" ]; then
  bindkey -v
  bindkey '^R' history-incremental-search-backward
  bindkey '^X^E' edit-command-line
fi
