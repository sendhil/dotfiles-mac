#!/bin/sh

set -eu

if [ "$#" -ne 0 ]; then
  printf 'usage: sway-scratchpad\n' >&2
  exit 2
fi

read_tree() {
  if tree=$(swaymsg -t get_tree -r); then
    :
  else
    return $?
  fi
  printf '%s\n' "$tree" | jq -e 'type == "object"' >/dev/null || return 1
}

scratch_exists() {
  printf '%s\n' "$tree" | jq -e \
    '[.. | objects | .app_id? // empty] | index("wezterm-scratchpad") != null' >/dev/null
}

show_scratch() {
  if result=$(swaymsg -- '[app_id="^wezterm-scratchpad$"] scratchpad show'); then
    :
  else
    exit $?
  fi
  printf '%s\n' "$result" | jq -e \
    'type == "array" and length > 0 and all(.[]; .success == true)' >/dev/null || exit 1
}

if read_tree; then
  :
else
  exit $?
fi

if scratch_exists; then
  show_scratch
  exit 0
fi

runtime_dir=${XDG_RUNTIME_DIR:-}
case $runtime_dir in
  /*) ;;
  *) exit 1 ;;
esac
[ -d "$runtime_dir" ] && [ -w "$runtime_dir" ] || exit 1
umask 077
lock_file="$runtime_dir/sway-scratchpad.lock"
exec 9>"$lock_file"
if flock -x -w 6 9; then
  :
else
  exit $?
fi

unlock() {
  flock -u 9 >/dev/null 2>&1 || :
}
trap unlock EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# The lock holder must recheck: another invocation may have launched WezTerm
# between our optimistic first check and lock acquisition.
if read_tree; then
  :
else
  exit $?
fi
if scratch_exists; then
  show_scratch
  exit 0
fi

wezterm start --always-new-process --class wezterm-scratchpad --cwd "$HOME" 9>&- &
wezterm_pid=$!
wezterm_running=1

# Keep the lock only for a bounded startup window. The kernel releases flock
# automatically on every exit path, so a killed helper cannot leave a stale lock.
attempts=50
while [ "$attempts" -gt 0 ]; do
  sleep 0.1
  if read_tree; then
    :
  else
    exit $?
  fi
  if scratch_exists; then
    exit 0
  fi

  if [ "$wezterm_running" -eq 1 ] && ! kill -0 "$wezterm_pid" 2>/dev/null; then
    if wait "$wezterm_pid"; then
      status=0
    else
      status=$?
    fi
    [ "$status" -eq 0 ] || exit "$status"
    # A successful launcher may exit just before Sway publishes the new tree;
    # keep polling within the existing bound instead of racing to failure.
    wezterm_running=0
  fi
  attempts=$((attempts - 1))
done

exit 1
