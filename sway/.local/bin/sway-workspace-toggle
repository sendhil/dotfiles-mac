#!/bin/sh

set -eu

usage() {
  printf 'usage: sway-workspace-toggle DIGIT\n' >&2
  exit 2
}

[ "$#" -eq 1 ] || usage
case $1 in
  [0-9]) digit=$1 ;;
  *) usage ;;
esac

set +e
workspaces=$(swaymsg -t get_workspaces -r)
status=$?
set -e
[ "$status" -eq 0 ] || exit "$status"

set +e
focused=$(printf '%s\n' "$workspaces" | jq -er \
  'if type != "array" then
     error("workspace response must be an array")
   else
     [.[] | select(type == "object" and .focused == true)] as $focused
     | if ($focused | length) != 1 then
         error("expected one focused workspace")
       else
         $focused[0].num
         | if type == "number" and . > 0 and floor == . then
             .
           else
             error("focused workspace number must be a positive integer")
           end
       end
   end')
status=$?
set -e
[ "$status" -eq 0 ] || exit 1

case $focused in
  ''|*[!0-9]*) exit 1 ;;
esac

if [ "$digit" -eq 0 ]; then
  primary=10
else
  primary=$digit
fi
secondary=$((primary + 10))

if [ "$focused" = "$primary" ]; then
  target=$secondary
else
  target=$primary
fi

set +e
result=$(swaymsg -- "workspace number $target")
status=$?
set -e
[ "$status" -eq 0 ] || exit "$status"
printf '%s\n' "$result" | jq -e \
  'type == "array" and length > 0 and all(.[]; .success == true)' >/dev/null || exit 1
