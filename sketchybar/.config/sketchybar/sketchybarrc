#!/bin/bash
# Catppuccin Mocha, tailored for AeroSpace. No native menu aliases or capture needed.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export CONFIG_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_DIR="$CONFIG_DIR/plugins"
# Keep the font and app-icons.json from the same snapshot.
sketchybar --load-font "$CONFIG_DIR/fonts/sketchybar-app-font.ttf"

sketchybar --bar position=top height=36 margin=0 y_offset=0 \
  color=0xff1e1e2e border_width=0 corner_radius=0 blur_radius=0 \
  shadow=off topmost=window sticky=on display=all \
  padding_left=9 padding_right=9 notch_width=220 font_smoothing=on

sketchybar --default \
  icon.font="Hack Nerd Font:Regular:16.0" label.font="SF Pro:Medium:12.0" \
  icon.color=0xffcdd6f4 label.color=0xffcdd6f4 \
  icon.padding_left=8 icon.padding_right=5 label.padding_left=1 label.padding_right=9 \
  padding_left=3 padding_right=3 \
  background.color=0xff313244 background.height=27 background.corner_radius=8 \
  popup.background.color=0xff1e1e2e popup.background.border_color=0xff45475a \
  popup.background.border_width=1 popup.background.corner_radius=10 popup.height=30

sketchybar --add event aerospace_workspace_change \
  --add event aerospace_focus_change

python3 "$PLUGIN_DIR/workspaces.py" --init
sketchybar --add item mocha.observer left \
  --set mocha.observer drawing=off updates=on update_freq=5 \
    script="python3 '$PLUGIN_DIR/workspaces.py'" \
  --subscribe mocha.observer aerospace_workspace_change aerospace_focus_change \
    front_app_switched display_change system_woke space_windows_change

sketchybar --add item mocha.clock right \
  --set mocha.clock icon=󰃭 icon.color=0xffb4befe update_freq=30 \
    background.drawing=on script="'$PLUGIN_DIR/status.sh' clock" \
    click_script="open -a Calendar" \
  --subscribe mocha.clock system_woke

sketchybar --add item mocha.battery right \
  --set mocha.battery icon.color=0xffa6e3a1 update_freq=60 \
    background.drawing=on script="'$PLUGIN_DIR/status.sh' battery" \
    click_script="open 'x-apple.systempreferences:com.apple.preference.battery'" \
  --subscribe mocha.battery power_source_change system_woke

sketchybar --add item mocha.volume right \
  --set mocha.volume icon=󰕾 icon.color=0xff89b4fa label.width=dynamic label.align=left \
    background.drawing=on update_freq=60 script="'$PLUGIN_DIR/status.sh' volume" \
    click_script="'$PLUGIN_DIR/action.sh' volume" popup.align=right \
  --subscribe mocha.volume volume_change mouse.scrolled mouse.exited.global system_woke
sketchybar --add slider mocha.volume.slider popup.mocha.volume 150 \
  --set mocha.volume.slider icon=󰕾 icon.color=0xff89b4fa label.drawing=off \
    slider.highlight_color=0xff89b4fa slider.background.color=0xff45475a \
    slider.background.height=4 slider.knob= slider.knob.color=0xffcdd6f4 \
    background.drawing=off padding_left=9 padding_right=14 \
    script="'$PLUGIN_DIR/action.sh' slider" \
  --subscribe mocha.volume.slider mouse.clicked
sketchybar --add item mocha.volume.settings popup.mocha.volume \
  --set mocha.volume.settings icon=󰓃 label="Sound settings…" background.drawing=off \
    click_script="sketchybar --set mocha.volume popup.drawing=off; open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'"

sketchybar --add item mocha.network right \
  --set mocha.network icon=󰖩 icon.color=0xff94e2d5 label.drawing=off \
    background.drawing=on update_freq=30 script="'$PLUGIN_DIR/status.sh' network" \
    click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'" \
  --subscribe mocha.network wifi_change system_woke

# Briefly present the focused app without ever consuming workspace room.
sketchybar --add item mocha.front right \
  --set mocha.front icon.drawing=off label.color=0xffa6adc8 label.max_chars=18 \
    background.drawing=off padding_right=10 script="'$PLUGIN_DIR/status.sh' front" \
  --subscribe mocha.front front_app_switched

sketchybar --update
