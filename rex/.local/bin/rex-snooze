#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""rex-snooze: snooze Rex panes and mark them blocked (OSC 7501) when due.

States
  snoozed  attention cleared (id=rex.snooze state=idle); countdown running
  ringing  timer expired (id=rex.snooze state=blocked); auto-clears on focus/input

Usage
  rex-snooze [ui] [-s SESSION] [-b BLOCK]          open the fzf picker
  rex-snooze set [-s SESSION] [-b BLOCK] SPEC      snooze a pane (e.g. "30m check PR")
  rex-snooze ack [--ringing-only|--all] [BLOCK...] clear snooze / ringing status
  rex-snooze list [-s SESSION] [-b BLOCK]          print picker rows
  rex-snooze preview [-s SESSION] [-b BLOCK] KEY   print preview for one row
  rex-snooze go KEY                                focus a snoozed/ringing pane
  rex-snooze daemon                                run the background timer/focus loop
"""

from __future__ import annotations

import base64
import fcntl
import json
import math
import os
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import time
from collections.abc import Callable
from contextlib import contextmanager, suppress
from datetime import datetime, timedelta
from pathlib import Path

STATE_DIR = Path(os.environ.get("REX_SNOOZE_DIR", Path.home() / ".local/share/rex-snooze"))
SNOOZES_FILE = STATE_DIR / "snoozes.json"
LOCK_FILE = STATE_DIR / "lock"
DAEMON_LOCK_FILE = STATE_DIR / "daemon.lock"
DAEMON_PID_FILE = STATE_DIR / "daemon.pid"
STATUS_FILE = STATE_DIR / "status"

SNOOZE_ID = "rex.snooze"
SNOOZE_APP = "snooze"
MAX_DURATION_SECS = 30 * 86400
DEFAULT_WINDOW = re.compile(r"^Window [0-9a-f]{8}$")
SAFE_TOKEN_RE = re.compile(r"^[A-Za-z0-9_./+-]{1,64}$")
SAFE_TTY_RE = re.compile(r"^/dev/ttys?\d+$")
SELF = os.path.realpath(__file__)

DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"
GREEN, BLUE, YELLOW, RED, CYAN = "\033[32m", "\033[34m", "\033[33m", "\033[31m", "\033[36m"

PRESETS: list[tuple[str, str, str]] = [
    ("15m", "15 minutes", "1"),
    ("30m", "30 minutes", "2"),
    ("1h", "1 hour", "3"),
    ("2h", "2 hours", "4"),
    ("4h", "4 hours", "5"),
    ("tomorrow", "tomorrow 9:00 AM", "t"),
]


# ----------------------------------------------------------------osc 7501 helpers

def _clean_text(text: str, max_bytes: int = 256) -> str:
    cleaned = re.sub(r"[\x00-\x1f\x7f-\x9f]+", " ", text or "").strip()
    raw = cleaned.encode("utf-8")
    if len(raw) > max_bytes:
        cleaned = raw[:max_bytes].decode("utf-8", errors="ignore").strip()
    return cleaned


def _b64(text: str, max_bytes: int = 256) -> str:
    cleaned = _clean_text(text, max_bytes)
    return base64.b64encode(cleaned.encode("utf-8")).decode("ascii")


def format_osc7501(
    state: str,
    *,
    record_id: str | None = None,
    kind: str | None = None,
    app: str | None = None,
    title: str | None = None,
    msg: str | None = None,
) -> str:
    pairs = [f"state={state}"]
    if record_id and SAFE_TOKEN_RE.match(record_id):
        pairs.append(f"id={record_id}")
    if state == "blocked" and kind and SAFE_TOKEN_RE.match(kind):
        pairs.append(f"kind={kind}")
    if app and SAFE_TOKEN_RE.match(app):
        pairs.append(f"app={app}")
    if title and (t64 := _b64(title, 192)):
        pairs.append(f"title={t64}")
    if msg and (m64 := _b64(msg, 256)):
        pairs.append(f"msg={m64}")
    return f"\x1b]7501;{':'.join(pairs)}\x1b\\"


CLEAR_SEQ = format_osc7501("clear", record_id=SNOOZE_ID)


def build_silence_sequences(records: list[dict], until_label: str, note: str = "") -> list[str]:
    """Quiet any active done/blocked/error records on the pane and set id=rex.snooze state=idle."""
    seqs: list[str] = []
    for rec in records or []:
        st = rec.get("state")
        rid = rec.get("id") or ""
        if rid != SNOOZE_ID and st in ("done", "blocked", "error", "failed"):
            if not rid:
                seqs.append(format_osc7501("idle", app=rec.get("app") or rec.get("effective_app")))
            else:
                seqs.append(format_osc7501("clear", record_id=rid))
    detail = f"Snoozed until {until_label}" + (f" — {note}" if note else "")
    seqs.append(format_osc7501("idle", record_id=SNOOZE_ID, app=SNOOZE_APP, title="Snoozed", msg=detail))
    return seqs


def build_wakeup_sequence(entry: dict) -> str:
    dur = entry.get("duration_str") or "snooze"
    note = (entry.get("note") or "").strip()
    win = (entry.get("window_label") or "").strip()
    if note:
        msg = f"⏰ Snooze ({dur}): {note}"
    elif win and not DEFAULT_WINDOW.match(win):
        msg = f"⏰ Snooze expired ({dur}) — {win}"
    else:
        msg = f"⏰ Snooze expired ({dur})"
    return format_osc7501("blocked", record_id=SNOOZE_ID, kind="question", app=SNOOZE_APP, title="Snooze expired", msg=msg)


def write_tty_direct(tty: str | None, data: str) -> bool:
    if not tty or not data:
        return False
    path = tty if tty.startswith("/dev/") else f"/dev/{tty}"
    if not SAFE_TTY_RE.match(path):
        return False
    payload = memoryview(data.encode("utf-8"))
    try:
        fd = os.open(path, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        sent = 0
        while sent < len(payload):
            try:
                n = os.write(fd, payload[sent:])
                if n <= 0:
                    return False
                sent += n
            except BlockingIOError:
                _, w, _ = select.select([], [fd], [], 0.5)
                if not w:
                    return False
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def get_tty_atime(tty: str | None) -> int:
    if not tty:
        return 0
    path = tty if tty.startswith("/dev/") else f"/dev/{tty}"
    if not SAFE_TTY_RE.match(path):
        return 0
    try:
        return os.stat(path).st_atime_ns
    except OSError:
        return 0


# ----------------------------------------------------------------duration & note parsing

_COMPOUND_RE = re.compile(
    r"^(?:(?P<d>\d{1,6}(?:\.\d{1,4})?)d)?\s*(?:(?P<h>\d{1,6}(?:\.\d{1,4})?)h)?\s*(?:(?P<m>\d{1,6}(?:\.\d{1,4})?)m)?\s*(?:(?P<s>\d{1,6}(?:\.\d{1,4})?)s)?$",
    re.IGNORECASE,
)
_CLOCK_RE = re.compile(r"^(?P<h>\d{1,2})(?::(?P<m>\d{2}))?\s*(?P<ampm>am|pm)?$", re.IGNORECASE)


def _clamp_secs(secs: int) -> int:
    return max(1, min(secs, MAX_DURATION_SECS))


def _parse_single_token_duration(token: str, now: datetime) -> tuple[int, str] | None:
    low = token.strip().lower()
    if not low:
        return None
    if low in ("tomorrow", "tmrw", "tom"):
        target = (now + timedelta(days=1)).replace(hour=9, minute=0, second=0, microsecond=0)
        return _clamp_secs(math.ceil((target - now).total_seconds())), "tomorrow 9am"
    if re.fullmatch(r"\d+", low):
        mins = min(int(low), MAX_DURATION_SECS // 60)
        if mins > 0:
            return _clamp_secs(mins * 60), f"{mins}m"
    m = _COMPOUND_RE.fullmatch(low)
    if m and any(m.group(k) for k in ("d", "h", "m", "s")):
        total = round(
            float(m.group("d") or 0) * 86400
            + float(m.group("h") or 0) * 3600
            + float(m.group("m") or 0) * 60
            + float(m.group("s") or 0)
        )
        if total > 0:
            return _clamp_secs(total), low
    if re.fullmatch(r"\d+[dhms]", low):
        return MAX_DURATION_SECS, "30d"
    c = _CLOCK_RE.fullmatch(low)
    if c and (c.group("m") is not None or c.group("ampm") is not None):
        hour, minute = int(c.group("h")), int(c.group("m") or 0)
        ampm = (c.group("ampm") or "").lower()
        if ampm == "pm" and 1 <= hour < 12:
            hour += 12
        elif ampm == "am" and hour == 12:
            hour = 0
        if 0 <= hour <= 23 and 0 <= minute <= 59:
            target = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
            if target <= now:
                target += timedelta(days=1)
            return _clamp_secs(math.ceil((target - now).total_seconds())), target.strftime("%H:%M")
    return None


def parse_spec(query: str, fallback_key: str = "preset:30m", now: datetime | None = None) -> tuple[int, str, str]:
    now = now or datetime.now()
    q = _clean_text(query or "", 200)
    if q:
        parts = q.split(None, 1)
        if (parsed := _parse_single_token_duration(parts[0], now)) is not None:
            return parsed[0], parsed[1], (parts[1].strip() if len(parts) > 1 else "")
    preset_tok = fallback_key.split(":", 1)[1] if fallback_key.startswith("preset:") else "30m"
    secs, label = _parse_single_token_duration(preset_tok, now) or (1800, "30m")
    return secs, label, q


# ----------------------------------------------------------------rex helpers

class RexError(RuntimeError):
    pass


def rex(*args: str, json_out: bool = False, check: bool = True, timeout: float = 10):
    proc = subprocess.run(
        ["rex", "--autostart=false", *args],
        check=False,
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    if check and proc.returncode != 0:
        raise RexError((proc.stderr or proc.stdout).strip() or f"rex {' '.join(args)} failed")
    return json.loads(proc.stdout or "null") if json_out else proc.stdout


def list_sessions() -> list[dict]:
    try:
        return (rex("ls", "--json", json_out=True) or {}).get("sessions", [])
    except (RexError, OSError, ValueError, subprocess.SubprocessError):
        return []


def live_session_ids() -> set[str] | None:
    try:
        res = rex("ls", "--json", json_out=True)
        if isinstance(res, dict) and isinstance(res.get("sessions"), list):
            return {s["session_id"] for s in res["sessions"] if isinstance(s, dict) and s.get("session_id")}
    except (RexError, OSError, ValueError, subprocess.SubprocessError):
        pass
    return None


def inspect_session(session_id: str) -> dict | None:
    try:
        res = rex("session", "inspect", session_id, "--json", json_out=True)
        return res if isinstance(res, dict) else None
    except (RexError, OSError, ValueError, subprocess.SubprocessError):
        return None


def resolve_active_views(sids: set[str]) -> dict[str, dict | None]:
    views: dict[str, dict | None] = {}
    missing: list[str] = []
    for sid in sids:
        v = inspect_session(sid)
        views[sid] = v
        if v is None:
            missing.append(sid)
    if missing and (live := live_session_ids()) is not None:
        for sid in missing:
            if sid not in live:
                views[sid] = {"windows": []}
    return views


def block_process(session_id: str, block_id: str) -> dict:
    try:
        return rex("block", "call", "-s", session_id, "-b", block_id, "process", json_out=True, timeout=4) or {}
    except (RexError, OSError, ValueError, subprocess.SubprocessError):
        return {}


def block_program_status(session_id: str, block_id: str) -> list[dict]:
    try:
        res = rex("block", "call", "-s", session_id, "-b", block_id, "program_status", json_out=True, timeout=4)
        return (res or {}).get("records") or []
    except (RexError, OSError, ValueError, subprocess.SubprocessError):
        return []


def capture_tail(session_id: str, block_id: str, n: int = 40) -> list[str]:
    try:
        return rex("capture", "-s", session_id, "-b", block_id, "--trim", "--unwrap", timeout=6).splitlines()[-n:]
    except (RexError, OSError, ValueError, subprocess.SubprocessError):
        return []


def resolve_tty_from_process(proc: dict) -> str | None:
    pids: list[str] = []
    if (fg := proc.get("foreground") or {}).get("pid"):
        pids.append(str(int(fg["pid"])))
    pids.extend(str(int(a["pid"])) for a in (proc.get("ancestors") or []) if a.get("pid"))
    if (child := proc.get("child") or {}).get("pid"):
        pids.append(str(int(child["pid"])))
    if not pids:
        return None
    with suppress(OSError, subprocess.SubprocessError):
        out = subprocess.run(
            ["ps", "-o", "tty=", "-p", ",".join(pids)],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        ).stdout
        for line in out.splitlines():
            tty = line.strip()
            if tty and tty != "??":
                path = tty if tty.startswith("/dev/") else f"/dev/{tty}"
                if SAFE_TTY_RE.match(path):
                    return path
    return None


def classify_proc(proc: dict) -> tuple[str, str]:
    fg = proc.get("foreground") or {}
    cwd = fg.get("cwd") or next((a.get("cwd") for a in proc.get("ancestors", []) if a.get("cwd")), None)
    cwd = cwd or proc.get("home") or str(Path.home())
    argv0 = (fg.get("argv0") or fg.get("name") or "").lstrip("-")
    return _clean_text(os.path.basename(argv0) or "shell", 64), cwd


def find_block_context(session_id: str | None, block_id: str) -> dict | None:
    sessions = [{"session_id": session_id}] if session_id else list_sessions()
    for s in sessions:
        if not (sid := s.get("session_id")) or not (view := inspect_session(sid)):
            continue
        for i, w in enumerate(view.get("windows") or []):
            wlabel = _clean_text(w.get("label") or "", 80)
            if not wlabel or DEFAULT_WINDOW.match(wlabel):
                wlabel = f"tab {i + 1}"
            for layer in w.get("layers") or []:
                for b in layer.get("blocks") or []:
                    if b.get("block_id") == block_id:
                        return {
                            "session_id": sid,
                            "session_label": _clean_text(view.get("label") or sid, 80),
                            "window_id": w.get("window_id") or "",
                            "window_label": wlabel,
                            "block_id": block_id,
                        }
    return None


# ----------------------------------------------------------------state & daemon lock

def _read_entries() -> tuple[dict[str, dict], str]:
    if not SNOOZES_FILE.exists():
        return {}, ""
    with suppress(OSError, ValueError):
        raw_text = SNOOZES_FILE.read_text(encoding="utf-8")
        parsed = json.loads(raw_text)
        if isinstance(parsed, dict):
            return parsed, raw_text
    return {}, ""


def load_entries() -> dict[str, dict]:
    return _read_entries()[0]


@contextmanager
def _locked_state():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK_FILE, "a+", encoding="utf-8") as lf:
        fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
        try:
            entries, before_raw = _read_entries()
            yield entries
            after_raw = json.dumps(entries, indent=2, sort_keys=True)
            if after_raw != before_raw:
                tmp = SNOOZES_FILE.with_suffix(".tmp")
                tmp.write_text(after_raw, encoding="utf-8")
                tmp.replace(SNOOZES_FILE)
        finally:
            fcntl.flock(lf.fileno(), fcntl.LOCK_UN)


def _is_daemon_lock_held() -> bool:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(DAEMON_LOCK_FILE, "a+", encoding="utf-8") as dlf:
        try:
            fcntl.flock(dlf.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(dlf.fileno(), fcntl.LOCK_UN)
        return False


def _notify_or_start_daemon(*, has_entries: bool) -> None:
    """Must be called while holding _locked_state()."""
    if _is_daemon_lock_held():
        with suppress(OSError, ValueError):
            pid = int(DAEMON_PID_FILE.read_text(encoding="utf-8").strip())
            os.kill(pid, signal.SIGUSR1)
        return
    DAEMON_PID_FILE.unlink(missing_ok=True)
    if has_entries:
        subprocess.Popen(
            [sys.executable, SELF, "daemon"],
            env={**os.environ, "REX_SNOOZE_DIR": str(STATE_DIR)},
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def wait_interruptible(rfd: int, seconds: float) -> None:
    if seconds <= 0:
        return
    ready, _, _ = select.select([rfd], [], [], seconds)
    if ready:
        with suppress(OSError):
            while os.read(rfd, 256):
                pass


def status(msg: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATUS_FILE.write_text(f"{datetime.now():%H:%M} {msg}\n", encoding="utf-8")
    print(msg)


# ----------------------------------------------------------------daemon state machine

def _block_state_in_view(view: dict | None, block_id: str) -> str:
    """Return 'unknown', 'absent', 'unfocused', or 'focused'."""
    if view is None:
        return "unknown"
    active_win = view.get("active_window_id")
    for w in view.get("windows") or []:
        for layer in w.get("layers") or []:
            for b in layer.get("blocks") or []:
                if b.get("block_id") == block_id:
                    if w.get("window_id") == active_win and w.get("focused_block_id") == block_id:
                        return "focused"
                    return "unfocused"
    return "absent"


def process_entries(
    entries: dict[str, dict],
    *,
    views: dict[str, dict | None],
    tty_atimes: dict[str, int],
    now: float,
    write_tty: Callable[[str | None, str], bool] = write_tty_direct,
    inspected_at: float | None = None,
) -> None:
    for bid in list(entries.keys()):
        entry = entries[bid]
        sid = entry.get("session_id") or ""
        bstate = _block_state_in_view(views.get(sid), bid)

        if bstate == "absent":
            created = float(entry.get("created_at") or 0)
            if inspected_at is None or created <= inspected_at:
                entries.pop(bid, None)
            continue
        if bstate == "unknown":
            continue

        is_focused = bstate == "focused"
        tty = entry.get("tty")
        state = entry.get("state", "snoozed")
        due_at = float(entry.get("due_at") or 0)

        if state == "snoozed":
            if now >= due_at and write_tty(tty, build_wakeup_sequence(entry)):
                entry["state"] = "ringing"
                entry["seen_unfocused"] = not is_focused
                entry["tty_atime_at_expiry"] = get_tty_atime(tty) or tty_atimes.get(tty or "", 0)
        elif state == "ringing":
            if not is_focused and not entry.get("seen_unfocused"):
                entry["seen_unfocused"] = True
                continue
            cur_atime = tty_atimes.get(tty or "", 0)
            exp_atime = int(entry.get("tty_atime_at_expiry") or 0)
            should_clear = (is_focused and bool(entry.get("seen_unfocused"))) or (cur_atime > exp_atime > 0)
            if should_clear and write_tty(tty, CLEAR_SEQ):
                entries.pop(bid, None)


def next_sleep_seconds(entries: dict[str, dict], now: float) -> float:
    if not entries:
        return 0.0
    if any(e.get("state") == "ringing" or now >= float(e.get("due_at") or 0) for e in entries.values()):
        return 1.0
    earliest_due = min(float(e.get("due_at") or now) for e in entries.values())
    return min(60.0, max(1.0, earliest_due - now))


def cmd_daemon(_args: list[str]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(DAEMON_LOCK_FILE, "a+", encoding="utf-8") as dlf:
        try:
            fcntl.flock(dlf.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return

        rfd, wfd = os.pipe()
        os.set_blocking(rfd, False)
        os.set_blocking(wfd, False)
        prev_wakeup = signal.set_wakeup_fd(wfd, warn_on_full_buffer=False)
        signal.signal(signal.SIGUSR1, lambda _sig, _frame: None)

        try:
            with _locked_state() as entries:
                if not entries:
                    DAEMON_PID_FILE.unlink(missing_ok=True)
                    fcntl.flock(dlf.fileno(), fcntl.LOCK_UN)
                    return
                DAEMON_PID_FILE.write_text(f"{os.getpid()}\n", encoding="utf-8")

            while True:
                snapshot = load_entries()
                now = time.time()
                active = [
                    e for e in snapshot.values()
                    if e.get("state") == "ringing" or now >= float(e.get("due_at") or 0)
                ]
                views: dict[str, dict | None] = {}
                atimes: dict[str, int] = {}
                inspected_at = time.time()

                if active:
                    sids = {e.get("session_id") for e in active if e.get("session_id")}
                    views = resolve_active_views({s for s in sids if s})
                    for e in active:
                        if tty := e.get("tty"):
                            atimes[tty] = get_tty_atime(tty)

                with _locked_state() as entries:
                    if active:
                        process_entries(
                            entries,
                            views=views,
                            tty_atimes=atimes,
                            now=time.time(),
                            inspected_at=inspected_at,
                        )
                    if not entries:
                        DAEMON_PID_FILE.unlink(missing_ok=True)
                        fcntl.flock(dlf.fileno(), fcntl.LOCK_UN)
                        return
                    sleep_for = next_sleep_seconds(entries, time.time())

                wait_interruptible(rfd, sleep_for)
        finally:
            with suppress(OSError, ValueError):
                signal.set_wakeup_fd(prev_wakeup)
            with suppress(OSError):
                os.close(rfd)
                os.close(wfd)


# ----------------------------------------------------------------core operations

def snooze_block(session_id: str | None, block_id: str, duration_secs: int, duration_label: str, note: str = "") -> dict:
    ctx = find_block_context(session_id, block_id)
    if not ctx:
        raise RexError(f"pane {block_id} not found")
    sid = ctx["session_id"]
    proc = block_process(sid, block_id)
    tty = resolve_tty_from_process(proc)
    if not tty:
        raise RexError(f"unable to resolve TTY for pane {block_id}")
    prog, cwd = classify_proc(proc)
    records = block_program_status(sid, block_id)

    now = time.time()
    due_at = now + duration_secs
    until_dt = datetime.fromtimestamp(due_at)
    until_label = until_dt.strftime("%H:%M") if until_dt.date() == datetime.now().date() else until_dt.strftime("%a %H:%M")
    clean_note = _clean_text(note, 160)
    silence_payload = "".join(build_silence_sequences(records, until_label=until_label, note=clean_note))

    entry = {
        **ctx,
        "program": prog,
        "cwd": cwd,
        "tty": tty,
        "created_at": now,
        "due_at": due_at,
        "duration_str": _clean_text(duration_label, 32),
        "note": clean_note,
        "state": "snoozed",
    }
    with _locked_state() as entries:
        if not write_tty_direct(tty, silence_payload):
            raise RexError(f"failed to write OSC 7501 status to {tty}")
        entries[block_id] = entry
        _notify_or_start_daemon(has_entries=True)
    return entry


def ack_blocks(
    block_ids: list[str],
    *,
    ringing_only: bool = False,
    clear_all: bool = False,
    fallback_block_id: str | None = None,
) -> int:
    normalized: list[str] = []
    for raw in block_ids:
        if raw.startswith("preset:"):
            if fallback_block_id:
                normalized.append(fallback_block_id)
        elif raw.startswith(("pane:", "unsnooze:")):
            normalized.append(raw.split(":", 1)[1])
        elif raw:
            normalized.append(raw)

    if not normalized and not clear_all:
        return 0

    removed = 0
    with _locked_state() as entries:
        targets = list(entries.keys()) if clear_all else normalized
        for bid in targets:
            entry = entries.get(bid)
            if not entry:
                continue
            if ringing_only and entry.get("state") != "ringing":
                continue
            tty = entry.get("tty")
            cleared = not tty or write_tty_direct(tty, CLEAR_SEQ) or not Path(tty).exists()
            if cleared or not ringing_only:
                entries.pop(bid, None)
                removed += 1
        _notify_or_start_daemon(has_entries=bool(entries))
    return removed


# ----------------------------------------------------------------formatting & cli

def _parse_target_flags(args: list[str]) -> tuple[str | None, str | None, list[str]]:
    session_id = os.environ.get("REX_SNOOZE_SESSION") or os.environ.get("REX_SESSION")
    block_id = os.environ.get("REX_SNOOZE_BLOCK") or os.environ.get("REX_BLOCK")
    rest: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-s", "--session") and i + 1 < len(args):
            session_id = args[i + 1]
            i += 2
        elif a in ("-b", "--block") and i + 1 < len(args):
            block_id = args[i + 1]
            i += 2
        else:
            rest.append(a)
            i += 1
    return session_id, block_id, rest


def _fmt_remaining(due_at: float, now: float | None = None) -> str:
    diff = round(due_at - (now or time.time()))
    if diff <= 0:
        ago = abs(diff)
        if ago < 60:
            return "just now"
        return f"{ago // 60}m ago" if ago < 3600 else f"{ago // 3600}h {(ago % 3600) // 60}m ago"
    if diff < 60:
        return f"in {diff}s"
    return f"in {diff // 60}m" if diff < 3600 else f"in {diff // 3600}h {(diff % 3600) // 60}m"


def _tilde(path: str | None) -> str:
    home = str(Path.home())
    return ("~" + path[len(home):]) if path and path.startswith(home) else (path or "?")


def render_list(block_id: str | None) -> str:
    now_dt = datetime.now()
    now_ts = time.time()
    entries = load_entries()
    rows: list[str] = []

    if block_id and block_id in entries:
        cur = entries[block_id]
        st_lbl = "ringing" if cur.get("state") == "ringing" else f"due {_fmt_remaining(cur['due_at'], now_ts)}"
        rows.append(
            f"{YELLOW}✕  unsnooze{RESET}\tunsnooze:{block_id}\t{BOLD}Clear snooze on current pane{RESET}\t  {DIM}({st_lbl}){RESET}"
        )

    for code, desc, hk in PRESETS:
        secs, _, _ = parse_spec("", f"preset:{code}", now=now_dt)
        until_dt = now_dt + timedelta(seconds=secs)
        until_str = until_dt.strftime("%H:%M") if until_dt.date() == now_dt.date() else until_dt.strftime("%a %H:%M")
        rows.append(
            f"{CYAN}[{hk}]{RESET} {GREEN}⏱  {code:<8}{RESET}\tpreset:{code}\t{BOLD}Snooze {desc}{RESET}\t  {DIM}until {until_str}{RESET}"
        )

    sorted_entries = sorted(
        entries.values(),
        key=lambda e: (0 if e.get("state") == "ringing" else 1, float(e.get("due_at") or 0)),
    )
    for e in sorted_entries:
        bid = e.get("block_id", "")
        badge = f"{RED}● due     {RESET}" if e.get("state") == "ringing" else f"{BLUE}◐ snoozed {RESET}"
        when = _fmt_remaining(float(e.get("due_at") or 0), now_ts)
        until_str = datetime.fromtimestamp(float(e.get("due_at") or 0)).strftime("%H:%M")
        loc = f"{e.get('session_label', '?')} › {e.get('window_label', '?')}"
        prog = e.get("program") or "shell"
        note = f" — “{e['note']}”" if e.get("note") else ""
        me = "  (this pane)" if bid == block_id else ""
        rows.append(f"{badge}\tpane:{bid}\t{BOLD}{loc}{RESET}\t  {DIM}{prog} · {when} ({until_str}){note}{me}{RESET}")

    return "\n".join(rows)


def cmd_list(args: list[str]) -> None:
    _, block_id, _ = _parse_target_flags(args)
    print(render_list(block_id))


def cmd_preview(args: list[str]) -> None:
    session_id, block_id, rest = _parse_target_flags(args)
    key = rest[0] if rest else "preset:30m"
    cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", "80"))
    rule = DIM + "─" * min(cols, 80) + RESET
    entries = load_entries()

    target_bid = key.split(":", 1)[1] if key.startswith(("pane:", "unsnooze:")) else block_id
    if not target_bid:
        print("No target pane selected.")
        return

    entry = entries.get(target_bid)
    ctx = find_block_context(session_id if target_bid == block_id else (entry or {}).get("session_id"), target_bid)
    sid = (ctx or entry or {}).get("session_id") or session_id or ""
    slabel = (ctx or entry or {}).get("session_label") or "?"
    wlabel = (ctx or entry or {}).get("window_label") or "?"
    proc = block_process(sid, target_bid) if sid else {}
    prog, cwd = classify_proc(proc) if proc else ((entry or {}).get("program", "shell"), (entry or {}).get("cwd", "?"))

    print(f"{BOLD}{slabel} › {wlabel}{RESET}  {DIM}({prog} in {_tilde(cwd)}){RESET}")

    if key.startswith("preset:"):
        secs, dlabel, _ = parse_spec("", key)
        until_dt = datetime.now() + timedelta(seconds=secs)
        until_str = until_dt.strftime("%H:%M:%S" if secs < 60 else "%a %H:%M")
        print(f"{GREEN}▸ Preset: {BOLD}{dlabel}{RESET}{GREEN} (until {until_str}){RESET}")
    elif key.startswith("unsnooze:"):
        print(f"{YELLOW}▸ Will clear snooze on this pane{RESET}")

    if entry:
        st = entry.get("state", "snoozed")
        when = _fmt_remaining(float(entry.get("due_at") or 0))
        until_str = datetime.fromtimestamp(float(entry.get("due_at") or 0)).strftime("%H:%M")
        color = RED if st == "ringing" else BLUE
        note_line = f"\n  note: {BOLD}{entry['note']}{RESET}" if entry.get("note") else ""
        print(f"{color}● Currently {st}: {when} (target {until_str}){RESET}{note_line}")

    if sid and (tail := capture_tail(sid, target_bid, 35)):
        print(f"\n{rule}\n{DIM}recent pane output:{RESET}")
        print("\n".join(tail))


def cmd_set(args: list[str]) -> None:
    session_id, block_id, rest = _parse_target_flags(args)
    if not block_id:
        raise RexError("no target block specified")
    spec_str = " ".join(rest).strip() or "30m"
    secs, label, note = parse_spec(spec_str, f"preset:{spec_str.split()[0]}")
    entry = snooze_block(session_id, block_id, secs, label, note)
    until_str = datetime.fromtimestamp(entry["due_at"]).strftime("%H:%M")
    status(f"snoozed {entry['window_label']} for {label} (until {until_str})")


def cmd_ack(args: list[str]) -> None:
    _, block_id, rest = _parse_target_flags(args)
    ringing_only = False
    clear_all = False
    cleaned: list[str] = []
    for a in rest:
        if a == "--ringing-only":
            ringing_only = True
        elif a == "--all":
            clear_all = True
        else:
            cleaned.append(a)
    targets = cleaned if cleaned else ([block_id] if block_id and not clear_all else [])
    n = ack_blocks(targets, ringing_only=ringing_only, clear_all=clear_all, fallback_block_id=block_id)
    status(f"cleared {n} snooze(s)" if n else "nothing to clear")


def cmd_go(args: list[str]) -> None:
    _, _, rest = _parse_target_flags(args)
    if not rest:
        return
    key = rest[0]
    bid = key.split(":", 1)[1] if key.startswith(("pane:", "unsnooze:")) else key
    entry = load_entries().get(bid)
    sid_hint = (entry or {}).get("session_id")
    ctx = find_block_context(sid_hint, bid)
    if not ctx:
        if sid_hint and (live := live_session_ids()) is not None and sid_hint not in live:
            ack_blocks([bid])
        status("pane no longer exists")
        return
    sid, wid = ctx["session_id"], ctx["window_id"]
    if entry and entry.get("state") == "ringing":
        ack_blocks([bid], ringing_only=True)
    rex("focus", "-s", sid, bid, check=False)
    rex("do", "session.select", f"session_id={sid}", f"window_id={wid}", check=False, timeout=5)


def cmd_apply(args: list[str]) -> None:
    session_id, block_id, rest = _parse_target_flags(args)
    key = (rest[0] if rest else "").strip() or "preset:30m"
    query = (rest[1] if len(rest) > 1 else "").strip()

    if key.startswith("unsnooze:") and not query:
        ack_blocks([key.split(":", 1)[1]])
        return
    if key.startswith("pane:") and not query:
        cmd_go([key])
        return

    if key.startswith("pane:"):
        target_bid = key.split(":", 1)[1]
        target_sid = (load_entries().get(target_bid) or {}).get("session_id")
    else:
        target_bid = block_id
        target_sid = session_id
    if not target_bid:
        raise RexError("no target pane to snooze")
    secs, label, note = parse_spec(query, key if key.startswith("preset:") else "preset:30m")
    snooze_block(target_sid, target_bid, secs, label, note)


HELP = (
    "enter snooze/go   1-5/t quick preset   u/x unsnooze\n"
    "/ custom duration or note (e.g. '45m' or '30m check CI')   esc/q close"
)


def cmd_header(args: list[str]) -> None:
    _, _, rest = _parse_target_flags(args)
    key = rest[0] if rest else "preset:30m"
    query = (rest[1] if len(rest) > 1 else "").strip()
    print(HELP)
    if query:
        secs, dlabel, note = parse_spec(query, key if key.startswith("preset:") else "preset:30m")
        until_dt = datetime.now() + timedelta(seconds=secs)
        until_str = until_dt.strftime("%H:%M:%S" if secs < 60 else "%a %H:%M")
        note_str = f" — “{note}”" if note else ""
        print(f"{GREEN}▸ Custom: {BOLD}{dlabel}{RESET}{GREEN} (until {until_str}){note_str}{RESET}")
    elif STATUS_FILE.exists():
        print(DIM + STATUS_FILE.read_text(encoding="utf-8").strip() + RESET)


def cmd_ui(args: list[str]) -> None:
    if not shutil.which("fzf"):
        sys.exit("fzf not found")
    session_id, block_id, _ = _parse_target_flags(args)
    STATUS_FILE.unlink(missing_ok=True)
    me = f"{shlex.quote(sys.executable)} {shlex.quote(SELF)}"
    target_flags = ""
    if session_id:
        target_flags += f" -s {shlex.quote(session_id)}"
    if block_id:
        target_flags += f" -b {shlex.quote(block_id)}"

    reload_cmd = f"reload({me} list{target_flags})+transform-header({me} header{target_flags} {{2}} {{q}})+clear-selection"
    normal_keys = "1,2,3,4,5,t,u,x,q,j,k,/"

    def run_or_reload(subcmd: str) -> str:
        return f"transform:{me} {subcmd} >/dev/null && echo abort || echo {shlex.quote(reload_cmd)}"

    binds = [
        f"enter:{run_or_reload(f'apply{target_flags} {{2}} {{q}}')}",
        *[f"{hk}:{run_or_reload(f'apply{target_flags} preset:{code} {{q}}')}" for code, _, hk in PRESETS],
        f"u:execute-silent({me} ack{target_flags} {{+2}})+{reload_cmd}",
        f"x:execute-silent({me} ack{target_flags} {{+2}})+{reload_cmd}",
        f"change:transform-header({me} header{target_flags} {{2}} {{q}})",
        "j:down",
        "k:up",
        "q:abort",
        f"/:unbind({normal_keys})+change-prompt(duration/note> )",
        f"esc:transform:[ \"$FZF_PROMPT\" = \"duration/note> \" ] && echo 'clear-query+rebind({normal_keys})+change-prompt(> )' || echo abort",
    ]
    fzf = [
        "fzf",
        "--ansi",
        "--disabled",
        "--multi",
        "--tabstop=1",
        "--delimiter=\t",
        "--with-nth=1,3,4",
        "--layout=reverse",
        "--border=rounded",
        "--border-label= rex snooze ",
        "--prompt=> ",
        "--marker=✓ ",
        "--pointer=▶",
        "--header",
        HELP,
        "--header-first",
        "--no-sort",
        "--tiebreak=index",
        f"--preview={me} preview{target_flags} {{2}}",
        "--preview-window=right,52%,wrap,<100(down,55%,wrap)",
        *[f"--bind={b}" for b in binds],
    ]
    subprocess.run(fzf, check=False, input=render_list(block_id), text=True)


COMMANDS = {
    "ui": cmd_ui,
    "list": cmd_list,
    "preview": cmd_preview,
    "set": cmd_set,
    "ack": cmd_ack,
    "go": cmd_go,
    "apply": cmd_apply,
    "header": cmd_header,
    "daemon": cmd_daemon,
}


def main() -> None:
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if not argv or argv[0].startswith("-"):
        cmd, rest = "ui", argv
    else:
        cmd, rest = argv[0], argv[1:]
    if cmd not in COMMANDS:
        sys.exit(f"unknown command {cmd!r}\n{__doc__}")
    try:
        COMMANDS[cmd](rest)
    except RexError as e:
        status(f"error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
