#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""rex-archive: archive and restore Rex sessions and tabs from an fzf picker.

States
  live      a normal Rex session
  archived  snapshot saved to disk, session killed; restore rebuilds it

Usage
  rex-archive                 open the picker (same as `rex-archive ui`)
  rex-archive list            print picker lines
  rex-archive preview KEY     print the preview for one entry
  rex-archive archive KEY...  snapshot + kill sessions
  rex-archive restore KEY...  rebuild archived sessions and tabs
  rex-archive delete KEY...   move archives to the trash folder
  rex-archive go KEY          show a session in the Rex app (restores archives first)

KEY is a session ID (session:...), a tab (tab:<session id>|<window id>), or archive:<name>;
labels also work for live sessions. An archived tab restores into its original session if it still exists, otherwise into the current session.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import shutil
import sqlite3
from contextlib import contextmanager
import subprocess
import sys
import time
import uuid
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from pathlib import Path

STATE_DIR = Path(os.environ.get("REX_ARCHIVE_DIR", Path.home() / ".local/share/rex-archive"))
ARCHIVE_DIR = STATE_DIR / "archived"
RESTORED_DIR = STATE_DIR / "restored"
TRASH_DIR = STATE_DIR / "trash"
STATUS_FILE = STATE_DIR / "status"
TAIL_LINES = 200
SHELLS = {"zsh", "bash", "fish", "sh", "dash", "nu", "tcsh", "ksh", "login"}
SELF = os.path.realpath(__file__)

DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"
GREEN, BLUE, RED = "\033[32m", "\033[34m", "\033[31m"


# ---------------------------------------------------------------- rex helpers

class RexError(RuntimeError):
    pass


def rex(*args: str, json_out: bool = False, check: bool = True, timeout: float = 20):
    proc = subprocess.run(["rex", *args], capture_output=True, text=True, timeout=timeout)
    if check and proc.returncode != 0:
        raise RexError((proc.stderr or proc.stdout).strip() or f"rex {' '.join(args)} failed")
    if json_out:
        return json.loads(proc.stdout or "null")
    return proc.stdout


def list_sessions() -> list[dict]:
    return rex("ls", "--json", json_out=True).get("sessions", [])


def inspect(session_id: str) -> dict:
    return rex("session", "inspect", session_id, "--json", json_out=True)


def block_process(session_id: str, block_id: str) -> dict:
    try:
        out = rex("block", "call", "-s", session_id, "-b", block_id, "process", timeout=5)
        return json.loads(out)
    except Exception:
        return {}


def capture_tail(session_id: str, block_id: str, n: int) -> list[str]:
    try:
        out = rex("capture", "-s", session_id, "-b", block_id, "--trim", "--unwrap", timeout=10)
    except Exception:
        return []
    return out.splitlines()[-n:]


def client_action(name: str, **kw: str) -> bool:
    """Best-effort app action (needs Remote Control enabled in the Rex app)."""
    args = [f"{k}={v}" for k, v in kw.items()]
    proc = subprocess.run(["rex", "do", name, *args], capture_output=True, text=True, timeout=10)
    return proc.returncode == 0


# ---------------------------------------------------------------- layout walking

def tiled_layout(window: dict) -> dict | None:
    for layer in window.get("layers", []):
        if layer.get("kind") == "tiled":
            return layer.get("layout")
    return None


def leaves(node: dict | None) -> list[str]:
    if not node:
        return []
    if "block_id" in node:
        return [node["block_id"]]
    sp = node.get("split", {})
    return leaves(sp.get("before")) + leaves(sp.get("after"))


def block_meta(window: dict) -> dict[str, dict]:
    meta = {}
    for layer in window.get("layers", []):
        for b in layer.get("blocks", []):
            meta[b["block_id"]] = {**b, "floating": layer.get("kind") != "tiled"}
    return meta


# ---------------------------------------------------------------- program detection

def classify(proc: dict) -> dict:
    """Work out what is running in a pane and how to bring it back."""
    fg = proc.get("foreground") or {}
    cwd = fg.get("cwd") or next((a.get("cwd") for a in proc.get("ancestors", []) if a.get("cwd")), None)
    cwd = cwd or proc.get("home") or str(Path.home())
    argv0 = (fg.get("argv0") or fg.get("name") or "").lstrip("-")
    prog = os.path.basename(argv0)
    pid = fg.get("pid")
    info = {"cwd": cwd, "program": prog or "shell", "kind": "shell", "cmd": None, "autorun": False}

    if not prog or prog in SHELLS:
        return info
    if prog == "claude":
        sid = None
        try:
            sid = json.loads((Path.home() / f".claude/sessions/{pid}.json").read_text()).get("sessionId")
        except Exception:
            pass
        sid = sid if isinstance(sid, str) and re.fullmatch(r"[a-zA-Z0-9-]+", sid) else None
        info.update(kind="agent", claude_session_id=sid, autorun=bool(sid),
                    cmd=f"claude --resume {sid}" if sid else "claude --continue")
        return info
    if prog == "pi":
        info.update(kind="agent", autorun=False, cmd="pi --continue")
        return info
    if prog == "codex":
        info.update(kind="agent", autorun=False, cmd="codex resume --last")
        return info

    # Anything else: recover the full command line locally, and type it without running it.
    cmd = prog
    if pid:
        try:
            full = subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                                  capture_output=True, text=True, timeout=3).stdout.strip()
            if full:
                cmd = full
        except Exception:
            pass
    info.update(kind="other", cmd=cmd, autorun=False)
    return info


# ---------------------------------------------------------------- snapshot

def snapshot(session_id: str, window_id: str | None = None, *, picker_ui: bool = True) -> dict:
    """Snapshot a whole session, or just one tab of it when window_id is given."""
    view = inspect(session_id)
    if window_id:
        original_name = tab_name(next((w.get("label", "") for w in view["windows"] if w["window_id"] == window_id), ""), view, window_id)
        view["windows"] = [w for w in view.get("windows", []) if w["window_id"] == window_id]
        if not view["windows"]:
            raise RexError(f"tab {window_id} not found")
        view["active_window_id"] = window_id
    # The picker's own pane: left out when it floats (palette launch); kept as a plain
    # shell when it's a tiled pane you ran `rex-archive` from.
    picker = os.environ.get("REX_BLOCK") if picker_ui else None
    for w in view.get("windows", []):
        for layer in w.get("layers", []):
            if layer.get("kind") != "tiled":
                layer["blocks"] = [b for b in layer.get("blocks", []) if b["block_id"] != picker]
    jobs = {}
    with ThreadPoolExecutor(max_workers=8) as pool:
        for w in view.get("windows", []):
            for bid in block_meta(w):
                jobs[bid] = (pool.submit(block_process, session_id, bid),
                             pool.submit(capture_tail, session_id, bid, TAIL_LINES))
    panes = {}
    for bid, (pf, tf) in jobs.items():
        panes[bid] = {**classify(pf.result()), "tail": tf.result()}
        if bid == picker:
            panes[bid].update(kind="shell", cmd=None, autorun=False, program="shell")

    def build(node):
        if not node:
            return None
        if "block_id" in node:
            return {"pane": node["block_id"]}
        sp = node["split"]
        return {"split": sp.get("direction", "horizontal"), "ratio": sp.get("ratio", 0.5),
                "before": build(sp.get("before")), "after": build(sp.get("after"))}

    windows = []
    active_index = 0
    for i, w in enumerate(view.get("windows", [])):
        if w["window_id"] == view.get("active_window_id"):
            active_index = i
        meta = block_meta(w)
        wpanes = {}
        for bid, m in meta.items():
            wpanes[bid] = {**panes[bid], "label": m.get("label", ""), "flavor": m.get("flavor", ""),
                           "floating": m["floating"], "focused": bid == w.get("focused_block_id")}
        windows.append({"source_window": w["window_id"], "label": w.get("label", ""), "layout": build(tiled_layout(w)), "panes": wpanes})

    session_label = view.get("label", "")
    data = {"version": 1, "type": "session", "label": session_label, "session_id": session_id,
            "session_label": session_label, "archived_at": time.time(),
            "active_window": active_index, "windows": windows}
    if window_id:
        data.update(type="tab", label=original_name)
    return data


# ---------------------------------------------------------------- restore

DEFAULT_WINDOW = re.compile(r"^Window [0-9a-f]{8}$")
DEFAULT_BLOCK = re.compile(r"^(Block [0-9a-f]{8}|shell)$")


def first_pane(node, panes):
    while node and "split" in node:
        node = node["before"]
    return panes.get(node["pane"]) if node else None


def tab_name(label: str, view: dict | None = None, window_id: str | None = None) -> str:
    if label and not DEFAULT_WINDOW.match(label):
        return label
    if view and window_id:
        ids = [w["window_id"] for w in view.get("windows", [])]
        if window_id in ids:
            return f"tab {ids.index(window_id) + 1}"
    return "tab"


def exact_resume(pane: dict) -> bool:
    sid = pane.get("claude_session_id")
    return bool(pane.get("autorun") and isinstance(sid, str) and re.fullmatch(r"[a-zA-Z0-9-]+", sid)
                and pane.get("cmd") == f"claude --resume {sid}")


def restore_archive(data: dict, into: str | None = None) -> tuple[str, list]:
    """Rebuild an archive. With `into`, its tabs are added to that existing session."""
    windows = data["windows"]
    if not windows:
        raise RexError("archive has no windows")
    session_id = into
    jobs: list[tuple[str, dict]] = []  # (new block id, pane spec)

    def grow(node, block_id, panes):
        if node is None:
            return
        if "pane" in node:
            jobs.append((block_id, panes[node["pane"]]))
            return
        direction = "right" if node["split"] == "horizontal" else "below"
        pct = max(1, min(99, round((1 - node["ratio"]) * 100)))
        cwd = (first_pane(node["after"], panes) or {}).get("cwd", str(Path.home()))
        out = rex("split", "-s", session_id, "-b", block_id, f"--split={direction}", f"--ratio={pct}",
                  "-c", cwd, "--focus=false", "--json", json_out=True)
        grow(node["before"], block_id, panes)
        grow(node["after"], out["block_ids"][0], panes)

    window_ids = []
    for i, w in enumerate(windows):
        label = w["label"] if w["label"] and not DEFAULT_WINDOW.match(w["label"]) else ""
        root = w["layout"]
        # Floating panes come back as extra tiled tabs would be surprising; fold them in as splits.
        tiled_ids = set()
        def collect(n):
            if n and "pane" in n: tiled_ids.add(n["pane"])
            elif n: collect(n["before"]); collect(n["after"])
        collect(root)
        extras = [pid for pid in w["panes"] if pid not in tiled_ids]
        for pid in extras:
            root = {"split": "vertical", "ratio": 0.7, "before": root, "after": {"pane": pid}} if root else {"pane": pid}
        cwd = (first_pane(root, w["panes"]) or {}).get("cwd", str(Path.home()))
        if session_id is None:
            args = ["new", data.get("session_label") or data.get("label") or "restored", "-c", cwd, "--json"]
            if label:
                args += ["--window", label]
            out = rex(*args, json_out=True)
            session_id = out["session_id"]
            win = out["initial_windows"][0]
            first_block, window_id = win["block_ids"][0], win.get("window_id")
        else:
            args = ["window", "new", "-s", session_id] + ([label] if label else []) + ["-c", cwd, "--focus=false", "--json"]
            out = rex(*args, json_out=True)
            first_block, window_id = out["block_ids"][0], out.get("window_id")
        window_ids.append(window_id)
        grow(root, first_block, w["panes"])

    def wait_for_prompt(block_id: str, limit: float = 4.0) -> None:
        # Typing before the shell draws its prompt echoes the text twice; wait for first output.
        deadline = time.time() + limit
        while time.time() < deadline:
            if capture_tail(session_id, block_id, 1):
                time.sleep(0.15)
                return
            time.sleep(0.1)

    with ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(wait_for_prompt, [b for b, p in jobs if p.get("cmd")]))

    for block_id, pane in jobs:
        lbl = pane.get("label", "")
        if lbl and not DEFAULT_BLOCK.match(lbl):
            rex("api", "call", "-s", session_id, "session.set_block_label",
                json.dumps({"block_id": block_id, "label": lbl}))
        if pane.get("cmd"):
            rex("send", "-s", session_id, "-b", block_id, pane["cmd"])
            if exact_resume(pane):
                rex("send-key", "-s", session_id, "-b", block_id, "enter")

    active = data.get("active_window", 0)
    if 0 <= active < len(window_ids) and window_ids[active]:
        rex("focus", "-s", session_id, window_ids[active])
    return session_id, window_ids


# ---------------------------------------------------------------- state helpers

def archives() -> list[Path]:
    if not ARCHIVE_DIR.is_dir():
        return []
    return sorted(ARCHIVE_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)


def archive_path(key: str) -> Path:
    name = key.removeprefix("archive:")
    if not key.startswith("archive:") or not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
        raise RexError("Invalid archive ID.")
    return ARCHIVE_DIR / f"{name}.json"


def resolve_session(key: str) -> dict | None:
    for s in list_sessions():
        if key in (s["session_id"], s["label"]) or s["session_id"].endswith(key):
            return s
    return None


def slug(text: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-")[:60] or "session"


def ago(ts: float) -> str:
    d = time.time() - ts
    for unit, secs in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= secs:
            return f"{int(d // secs)}{unit} ago"
    return "just now"


def tilde(path: str | None) -> str:
    home = str(Path.home())
    return ("~" + path[len(home):]) if path and path.startswith(home) else (path or "?")


def status(msg: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATUS_FILE.write_text(f"{datetime.now():%H:%M} {msg}\n")
    print(msg)


def own_session() -> str | None:
    return os.environ.get("REX_SESSION")


def own_window(view: dict | None) -> str | None:
    """The tab this picker is running in, so it never archives itself."""
    me = os.environ.get("REX_BLOCK")
    for w in (view or {}).get("windows", []):
        if me in block_meta(w):
            return w["window_id"]
    return None


def tab_key(session_id: str, window_id: str) -> str:
    return f"tab:{session_id}|{window_id}"


def parse_tab_key(key: str) -> tuple[str, str]:
    sid, wid = key[len("tab:"):].split("|", 1)
    return sid, wid


@contextmanager
def favorites_db():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(STATE_DIR / "favorites.sqlite3", timeout=12)
    db.row_factory = sqlite3.Row
    try:
        with db:
            db.execute("""CREATE TABLE IF NOT EXISTS favorite (
                id TEXT PRIMARY KEY, title TEXT NOT NULL, live TEXT UNIQUE, archive TEXT, slot INTEGER)""")
            db.execute("BEGIN IMMEDIATE")
            yield db
    finally:
        db.close()


def favorite_rows():
    with favorites_db() as db:
        saved = list(db.execute("SELECT * FROM favorite ORDER BY title COLLATE NOCASE, id"))
    sessions = {s["session_id"] for s in list_sessions()} if saved else set()
    windows = {}
    rows = []
    for f in saved:
        live = f["live"] or ""
        sid, wid = parse_tab_key(live) if live.startswith("tab:") else (live, None)
        present = sid in sessions
        if present and wid:
            if sid not in windows:
                windows[sid] = {w["window_id"] for w in inspect(sid)["windows"]}
            present = wid in windows[sid]
        archived = f["archive"] and archive_path(f["archive"]).is_file()
        state = "Live" if present else "Archived" if archived else "Missing"
        rows.append({**dict(f), "state": state, "session": sid, "window": wid})
    return rows


def cmd_star(keys):
    sessions = {s["session_id"]: s["label"] for s in list_sessions()}
    with favorites_db() as db:
        for key in dict.fromkeys(keys):
            archived = key.startswith("archive:")
            column = "archive" if archived else "live"
            slot = None
            if archived:
                data = json.loads(archive_path(key).read_text())
                slot = 0 if data.get("type") == "tab" else None
            removed = db.execute("DELETE FROM favorite WHERE archive=? AND slot IS ?", (key, slot)) if archived else db.execute(
                "DELETE FROM favorite WHERE live=?", (key,))
            if removed.rowcount:
                continue
            if archived:
                title = data["label"]
            elif key.startswith("tab:"):
                sid, wid = parse_tab_key(key)
                v = inspect(sid)
                w = next((w for w in v["windows"] if w["window_id"] == wid), None)
                if not w:
                    raise RexError("Tab no longer exists.")
                title = tab_name(w.get("label", ""), v, wid)
            elif key in sessions:
                title = sessions[key]
            else:
                raise RexError("Workspace no longer exists.")
            db.execute(f"INSERT INTO favorite(id,title,{column},slot) VALUES(?,?,?,?)",
                       (uuid.uuid4().hex, title, key, slot))
    status("Updated favorites")


def write_archive(data: dict) -> None:
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
    prefix = f"{slug(data['session_label'])}--" if data.get("type") == "tab" else ""
    path = ARCHIVE_DIR / f"{datetime.now():%Y%m%d-%H%M%S}-{prefix}{slug(data['label'])}-{uuid.uuid4().hex}.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.rename(path)
    sid = data.get("session_id")
    if sid:
        key = "archive:" + path.stem
        with favorites_db() as db:
            if data.get("type") != "tab":
                db.execute("UPDATE favorite SET archive=?,slot=NULL WHERE live=?", (key, sid))
            for i, w in enumerate(data["windows"]):
                if wid := w.get("source_window"):
                    db.execute("UPDATE favorite SET archive=?,slot=? WHERE live=?", (key, i, tab_key(sid, wid)))


# ---------------------------------------------------------------- commands

def tab_summary(sid, bid, picker=None):
    view = inspect(sid)
    w = next((w for w in view["windows"] if bid in block_meta(w)), None)
    if not w:
        raise RexError("The invoking pane no longer exists.")
    panes = block_meta(w)
    panes.pop(picker, None)
    with ThreadPoolExecutor(max_workers=8) as pool:
        programs = [classify(proc)["program"] if proc else "unknown"
                    for proc in pool.map(lambda b: block_process(sid, b), panes)]
    wid = w["window_id"]
    return {"window": wid, "scope": "session" if len(view["windows"]) == 1 else "tab",
                      "title": f"{view['label']} › {tab_name(w.get('label', ''), view, wid)}",
                      "detail": f"{len(panes)} pane(s): " + ", ".join(programs)}


def cmd_tab_summary(args):
    print(json.dumps(tab_summary(*args)))


def cmd_archive_confirmed(args, *, picker_ui=False):
    sid, wid, scope = args

    def check_scope():
        wins = inspect(sid)["windows"]
        if not any(w["window_id"] == wid for w in wins) or scope != ("session" if len(wins) == 1 else "tab"):
            raise RexError("Tab or session changed. Open Archive This Tab again.")

    check_scope()
    data = snapshot(sid, wid, picker_ui=picker_ui)
    if scope == "session":
        data.update(type="session", label=data["session_label"])
    write_archive(data)
    check_scope()
    rex(*(("kill", sid) if scope == "session" else ("window", "close", "-s", sid, wid)))
    print(json.dumps({"archived": data["label"]}))


def catalog():
    sessions = {s["session_id"]: s["label"] for s in list_sessions()}
    rows = []
    for path in archives():
        try:
            data = json.loads(path.read_text())
            tab = data.get("type") == "tab"
            orig = data.get("session_id")
            dest = (orig if orig in sessions else "choose") if tab else "new"
            subtitle = ("Tab from " + data["session_label"]) if tab else "Session"
            where = sessions.get(dest, "choose destination" if dest == "choose" else "new session")
            rows.append({"id": "archive:" + path.stem, "title": data["label"], "destination": dest,
                         "subtitle": f"{subtitle} → {where}", "detail": ago(data["archived_at"])})
        except (ValueError, KeyError, OSError):
            continue
    stars = star_keys()
    for row in rows:
        if row["id"] in stars:
            row["title"] = "★ " + row["title"]
    rows.sort(key=lambda r: r["id"] not in stars)
    return {"archives": rows, "sessions": [{"id": k, "title": v} for k, v in sessions.items()]}


def star_keys():
    with favorites_db() as db:
        return {k for row in db.execute("SELECT live,archive FROM favorite") for k in row if k}


def cmd_catalog(_args):
    print(json.dumps(catalog()))


def restore_to(key, dest):
    path = archive_path(key)
    data = json.loads(path.read_text())
    if dest != "new" and (data.get("type") != "tab" or dest not in {s["session_id"] for s in list_sessions()}):
        raise RexError("Restore destination is no longer available.")
    with favorites_db() as db:
        if not path.exists():
            raise RexError("Archive has already been restored or moved.")
        session, windows = restore_archive(data, into=None if dest == "new" else dest)
        for f in db.execute("SELECT id,slot FROM favorite WHERE archive=?", (key,)).fetchall():
            slot = f["slot"]
            live = tab_key(session, windows[slot]) if slot is not None else session
            db.execute("UPDATE favorite SET live=?, archive=NULL WHERE id=?", (live, f["id"]))
        RESTORED_DIR.mkdir(parents=True, exist_ok=True)
        path.rename(RESTORED_DIR / path.name)
    panes = [p for w in data["windows"] for p in w["panes"].values()]
    return {"session": session, "panes_reopened": len(panes),
                      "staged_commands": sum(1 for p in panes if p.get("cmd") and not exact_resume(p)),
                      "resume_commands_sent": sum(exact_resume(p) for p in panes)}


def open_favorite(fid, dest=None):
    row = next((r for r in favorite_rows() if r["id"] == fid), None)
    if not row or row["state"] == "Missing":
        raise RexError("Favorite is missing. No matching live workspace or archive.")
    if row["state"] == "Live":
        return {"session": row["session"], "window": row["window"]}
    item = next((r for r in catalog()["archives"] if r["id"] == row["archive"]), None)
    if not item:
        raise RexError("Archive no longer available.")
    target = item["destination"]
    if target == "choose" and dest is None:
        return {"choose": True}
    restore_to(row["archive"], dest if target == "choose" else target)
    # An archived tab may have been included in a whole-session snapshot.
    with favorites_db() as db:
        live = db.execute("SELECT live FROM favorite WHERE id=?", (fid,)).fetchone()[0]
    sid, wid = parse_tab_key(live) if live.startswith("tab:") else (live, None)
    return {"session": sid, "window": wid}


def cmd_restore_to(args):
    print(json.dumps(restore_to(*args)))


def cmd_list(_args) -> None:
    sessions = list_sessions()
    with ThreadPoolExecutor(max_workers=8) as pool:
        views = list(pool.map(lambda s: _safe(inspect, s["session_id"]), sessions))
    rows = []
    for s, v in zip(sessions, views):
        sid = s["session_id"]
        wins = (v or {}).get("windows", [])
        npanes = sum(len(leaves(tiled_layout(w))) for w in wins)
        detail = f"{len(wins)} tab{'s' * (len(wins) != 1)}, {npanes} pane{'s' * (npanes != 1)}"
        if sid == own_session():
            detail += "  (this session)"
        rows.append(f"{GREEN}●{RESET} {GREEN}live    {RESET}\t{sid}\t{BOLD}{s['label']}{RESET}\t  {DIM}{detail}{RESET}")
        # Tab rows: only when there is more than one tab (a lone tab is the session).
        if len(wins) > 1:
            mine = own_window(v) if sid == own_session() else None
            for i, w in enumerate(wins):
                branch = "└" if i == len(wins) - 1 else "├"
                labels = [m.get("label", "") for m in block_meta(w).values()]
                named = [l for l in labels if l and not DEFAULT_BLOCK.match(l)]
                tdetail = f"{len(labels)} pane{'s' * (len(labels) != 1)}" + (f": {', '.join(named)}" if named else "")
                if w["window_id"] == mine:
                    tdetail += "  (this tab)"
                rows.append(f"{DIM}   {branch}{RESET}      \t{tab_key(sid, w['window_id'])}\t"
                             f"{tab_name(w.get('label', ''), v, w['window_id'])}\t  {DIM}{tdetail}{RESET}")
    stars = star_keys()
    for row in rows:
        print(("★ " if row.split("\t")[1] in stars else "") + row)
    for p in archives():
        try:
            data = json.loads(p.read_text())
        except Exception:
            continue
        n = len(data.get("windows", []))
        when = ago(data.get("archived_at", p.stat().st_mtime))
        if data.get("type") == "tab":
            detail = f"tab from {data.get('session_label', '?')}, {when}"
        else:
            detail = f"{when}, {n} tab{'s' * (n != 1)}"
        star = "★ " if "archive:" + p.stem in stars else ""
        print(f"{star}{BLUE}○{RESET} {BLUE}archived{RESET}\tarchive:{p.stem}\t{data.get('label', p.stem)}\t  {DIM}{detail}{RESET}")


def _safe(fn, *a):
    try:
        return fn(*a)
    except Exception:
        return None


def _print_pane_line(pane: dict, indent="    ") -> None:
    what = pane.get("cmd") or pane.get("program") or "shell"
    marker = "▸" if pane.get("focused") else "·"
    lbl = pane.get("label", "")
    lbl = f"{lbl}: " if lbl and not DEFAULT_BLOCK.match(lbl) else ""
    run = "" if exact_resume(pane) or not pane.get("cmd") else f" {DIM}(typed, not run){RESET}"
    print(f"{indent}{marker} {lbl}{BOLD}{what}{RESET}{run}  {DIM}{tilde(pane.get('cwd'))}{RESET}")


def cmd_preview(args) -> None:
    key = args[0]
    cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", "80"))
    rule = DIM + "─" * min(cols, 80) + RESET
    if key.startswith("archive:"):
        data = json.loads(archive_path(key).read_text())
        what = f"tab from {data.get('session_label')}, " if data.get("type") == "tab" else ""
        print(f"{BOLD}{data['label']}{RESET}  {BLUE}{what}archived {ago(data['archived_at'])}{RESET}"
              f"  {DIM}{datetime.fromtimestamp(data['archived_at']):%a %b %d %H:%M}{RESET}")
        if data.get("type") == "tab":
            orig = resolve_session(data.get("session_id", ""))
            dest = f"back into {orig['label']}" if orig else "into the current session"
            print(f"{DIM}restores {dest}{RESET}")
        print()
        focus_tail = []
        for i, w in enumerate(data["windows"]):
            act = " *" if i == data.get("active_window") else ""
            print(f"  {i + 1}. {w['label']}{act}")
            for pane in w["panes"].values():
                _print_pane_line(pane)
                if pane.get("focused") and (i == data.get("active_window") or not focus_tail):
                    focus_tail = pane.get("tail", [])
        print(f"\n{rule}\n{DIM}output when archived:{RESET}")
        print("\n".join(focus_tail[-40:]))
        return

    only_window = None
    if key.startswith("tab:"):
        key, only_window = parse_tab_key(key)
    s = resolve_session(key)
    if not s:
        print("session no longer exists")
        return
    sid = s["session_id"]
    view = inspect(sid)
    state = f"{GREEN}live{RESET}"
    if only_window:
        print(f"{BOLD}{tab_name(next((w.get('label', '') for w in view['windows'] if w['window_id'] == only_window), ''), view, only_window)}"
              f"{RESET}  {DIM}tab in{RESET} {s['label']}  {state}\n")
        view["windows"] = [w for w in view.get("windows", []) if w["window_id"] == only_window]
        view["active_window_id"] = only_window
    else:
        print(f"{BOLD}{s['label']}{RESET}  {state}\n")
    blocks = [(w, bid) for w in view.get("windows", []) for bid in block_meta(w)]
    with ThreadPoolExecutor(max_workers=8) as pool:
        procs = dict(zip([b for _, b in blocks], pool.map(lambda wb: block_process(sid, wb[1]), blocks)))
    focus_block = None
    for i, w in enumerate(view.get("windows", [])):
        active = w["window_id"] == view.get("active_window_id")
        print(f"  {i + 1}. {w.get('label', '')}{' *' if active else ''}")
        for bid, m in block_meta(w).items():
            info = classify(procs.get(bid, {}))
            info.update(label=m.get("label", ""), focused=bid == w.get("focused_block_id"),
                        cmd=info["program"] if info["kind"] != "shell" else None, autorun=True)
            _print_pane_line(info)
            if active and bid == w.get("focused_block_id"):
                focus_block = bid
    if focus_block:
        print(f"\n{rule}\n{DIM}recent output (focused pane):{RESET}")
        print("\n".join(capture_tail(sid, focus_block, 40)))


def cmd_archive(keys, *, allow_promotion=True) -> None:
    done = []
    # Closing the picker's own tab or session kills this process, so that happens last,
    # after every snapshot is on disk and the status line is written.
    last_steps: list[tuple[str, ...]] = []
    session_keys = [k for k in keys if not k.startswith(("archive:", "tab:"))]
    sessions = [s for s in map(resolve_session, session_keys) if s]
    whole = {s["session_id"] for s in sessions}

    # Tabs first, skipping any whose whole session is also being archived.
    for key in keys:
        if not key.startswith("tab:"):
            continue
        sid, wid = parse_tab_key(key)
        if sid in whole:
            continue
        view = _safe(inspect, sid)
        if not view or wid not in [w["window_id"] for w in view.get("windows", [])]:
            continue
        if len(view["windows"]) == 1:  # last tab: archive the session instead
            if not allow_promotion:
                raise RexError("Last tab: select the whole session to archive it.")
            sessions.append({"session_id": sid, "label": view.get("label", "")})
            continue
        data = snapshot(sid, wid)
        write_archive(data)
        close = ("window", "close", "-s", sid, wid)
        if sid == own_session() and wid == own_window(view):
            last_steps.append(close)
        else:
            rex(*close)
        done.append(f"{data['label']} (tab)")

    for s in sessions:
        data = snapshot(s["session_id"])
        write_archive(data)
        if s["session_id"] == own_session():
            last_steps.append(("kill", s["session_id"]))
        else:
            rex("kill", s["session_id"])
        done.append(data["label"])
    status(f"archived {len(done)}: {', '.join(done)}" if done else "nothing archived")
    for step in last_steps:
        rex(*step, check=False)


def cmd_restore(keys, select: bool = False) -> None:
    done, errors, last = [], [], None
    for key in keys:
        try:
            if key.startswith("archive:"):
                path = archive_path(key)
                data = json.loads(path.read_text())
                if data.get("type") == "tab":
                    orig = resolve_session(data.get("session_id", ""))
                    into = orig["session_id"] if orig else own_session()
                    last = restore_to(key, into or "new")["session"]
                    dest = orig["label"] if orig else ("this session" if into else "a new session")
                    done.append(f"{data['label']} → {dest}")
                else:
                    last = restore_to(key, "new")["session"]
                    done.append(data["label"])
        except Exception as e:  # keep going with the rest of the selection
            errors.append(f"{key}: {e}")
    if select and last:
        client_action("session.select", session_id=last)
    msg = f"restored {len(done)}: {', '.join(done)}" if done else "nothing to restore"
    if errors:
        msg += f"  | {RED}errors:{RESET} " + "; ".join(errors)
    status(msg)


def cmd_delete(keys) -> None:
    TRASH_DIR.mkdir(parents=True, exist_ok=True)
    done = []
    for key in keys:
        if key.startswith("archive:") and archive_path(key).exists():
            p = archive_path(key)
            with favorites_db() as db:
                p.rename(TRASH_DIR / p.name)
                db.execute("DELETE FROM favorite WHERE archive=?", (key,))
            done.append(p.stem)
    status(f"trashed {len(done)} archive(s) → {tilde(str(TRASH_DIR))}" if done
           else "x only deletes archives (archive a session first)")


def cmd_go(args) -> None:
    key = args[0]
    if key.startswith("archive:"):
        cmd_restore([key], select=True)
        return
    if key.startswith("tab:"):
        sid, wid = parse_tab_key(key)
        if not client_action("session.select", session_id=sid, window_id=wid):
            status("couldn't switch the app (is Remote Control on in Rex settings?)")
        return
    s = resolve_session(key)
    if not s:
        return
    if not client_action("session.select", session_id=s["session_id"]):
        status("couldn't switch the app (is Remote Control on in Rex settings?)")


def pick(rows, header, prompt="Search> ", *, search=True):
    """Return a row index, never a parsed display label. Esc means no action."""
    clean = lambda s: " ".join("".join(c if c.isprintable() else " " for c in s).split())
    result = subprocess.run(["fzf", "--layout=reverse", "--delimiter=\\t", "--with-nth=2..",
                             "--header", header, "--prompt", prompt, *([] if search else ["--disabled"])],
                            input="".join(f"{i}\t{clean(row)}\n" for i, row in enumerate(rows)),
                            stdout=subprocess.PIPE, text=True, env=fzf_env())
    if result.returncode in (1, 130):
        return None
    if result.returncode:
        raise RexError(f"Picker failed (fzf exit {result.returncode})")
    return int(result.stdout.partition("\t")[0])


def fzf_env():
    # Don't inherit accept-on-match or action bindings into a destructive workflow.
    return {**os.environ, "FZF_DEFAULT_OPTS": "", "FZF_DEFAULT_OPTS_FILE": "/dev/null"}


def confirm(verb, names):
    closed = verb == "archive"
    action = "Archive & close" if closed else "Move to trash"
    header = "\n".join([action + "?", *names, "Running processes will stop." if closed else "Snapshots move to trash."])
    return pick(["Cancel", action], header, "Choose> ", search=False) == 1


def cmd_ui_tab(args):
    sid, bid = args
    tab = tab_summary(sid, bid, os.getenv("REX_BLOCK"))
    scope = "Last tab and whole session" if tab["scope"] == "session" else "Tab"
    if confirm("archive", [f"{scope}: {tab['title']}", tab["detail"]]):
        cmd_archive_confirmed([sid, tab["window"], tab["scope"]], picker_ui=True)


def cmd_ui_restore(_args):
    data = catalog()
    rows = data["archives"]
    if not rows:
        pick(["Close"], "No archived work. Use Archive This Tab to save a workspace.")
        return
    i = pick([f"{r['title']} · {r['subtitle']} · {r['detail']}" for r in rows], "Restore archived work · Enter restore · Esc cancel")
    if i is None:
        return
    row = rows[i]
    dest = row["destination"]
    if dest == "choose":
        targets = [{"id": "new", "title": "New session"}, *data["sessions"]]
        i = pick([s["title"] for s in targets], "Original session is gone. Restore tab into…")
        if i is None:
            return
        dest = targets[i]["id"]
    result = restore_to(row["id"], dest)
    client_action("session.select", session_id=result["session"])


def forget_missing(fid):
    if not any(r["id"] == fid and r["state"] == "Missing" for r in favorite_rows()):
        raise RexError("Favorite is no longer missing.")
    with favorites_db() as db:
        db.execute("DELETE FROM favorite WHERE id=?", (fid,))
    return {"removed": True}


def cmd_ui_favorites(_args):
    rows = favorite_rows()
    if not rows:
        pick(["Close"], "No favorites yet. In Manage Sessions & Archives, press Ctrl-F to star a row.")
        return
    i = pick([f"★ {r['title']} · {r['state']}" for r in rows], "Open favorite · Enter open · Esc cancel")
    if i is None:
        return
    row = rows[i]
    if row["state"] == "Missing":
        if pick(["Keep favorite", "Remove favorite"], f"{row['title']} is missing", search=False) == 1:
            forget_missing(row["id"])
        return
    result = open_favorite(row["id"])
    if result.get("choose"):
        targets = [{"id": "new", "title": "New session"}, *catalog()["sessions"]]
        i = pick([s["title"] for s in targets], "Original session is gone. Restore tab into…")
        if i is None:
            return
        result = open_favorite(row["id"], targets[i]["id"])
    args = {"session_id": result["session"]}
    if result.get("window"):
        args["window_id"] = result["window"]
    if not client_action("session.select", **args):
        raise RexError("Workspace is live but the app could not switch to it.")


def cmd_review(args):
    verb, *keys = args
    if verb not in ("archive", "trash") or not keys:
        return
    names = []
    if verb == "trash":
        for k in keys:
            if not k.startswith("archive:"):
                raise RexError("Select only saved archives to trash.")
            names.append(("★ Favorite archive (also removes star): " if k in star_keys() else "Saved archive: ") + json.loads(archive_path(k).read_text())["label"])
    else:
        sessions = {s["session_id"]: s["label"] for s in list_sessions()}
        for k in keys:
            if k in sessions:
                names.append("Whole session: " + sessions[k])
            elif k.startswith("tab:"):
                sid, wid = parse_tab_key(k)
                v = inspect(sid)
                w = next((w for w in v["windows"] if w["window_id"] == wid), None)
                if not w:
                    raise RexError("Tab no longer exists.")
                names.append(f"Tab: {sessions[sid]} › {tab_name(w.get('label', ''), v, wid)}")
            else:
                raise RexError("Select only live sessions or tabs to archive.")
    if confirm(verb, names):
        if verb == "archive":
            cmd_archive(keys, allow_promotion=False)
        else:
            cmd_delete(keys)


HELP = "Type to search · Enter open · Tab mark · Esc close\nCtrl-F star/unstar · Ctrl-A archive… · Ctrl-R restore · Ctrl-X trash…"


def cmd_header(_args) -> None:
    print(HELP)
    if STATUS_FILE.exists():
        print(DIM + STATUS_FILE.read_text().strip() + RESET)


def cmd_ui(_args) -> None:
    if not shutil.which("fzf"):
        sys.exit("fzf not found")
    STATUS_FILE.unlink(missing_ok=True)
    me = shlex.quote(SELF)
    reload = f"reload({me} list)+transform-header({me} header)+clear-selection"
    binds = [
        f"enter:execute-silent({me} go {{2}})+abort",
        f"ctrl-f:execute-silent({me} star {{+2}})+{reload}",
        f"ctrl-a:execute({me} review archive {{+2}})+{reload}",
        f"ctrl-r:execute-silent({me} restore {{+2}})+{reload}",
        f"ctrl-x:execute({me} review trash {{+2}})+{reload}",
    ]
    lister = subprocess.Popen([SELF, "list"], stdout=subprocess.PIPE)
    fzf = ["fzf", "--ansi", "--multi", "--tabstop=1", "--delimiter=\t", "--with-nth=1,3,4", "--layout=reverse",
           "--border=rounded", "--border-label= rex sessions ", "--prompt=Search> ", "--marker=✓ ",
           "--pointer=▶", "--header", HELP, "--header-first", "--no-sort", "--tiebreak=index",
           f"--preview={me} preview {{2}}", "--preview-window=right,50%,wrap,<100(down,55%,wrap)",
           *[f"--bind={b}" for b in binds]]
    subprocess.run(fzf, stdin=lister.stdout, env=fzf_env())


COMMANDS = {
    "ui-favorites": cmd_ui_favorites, "forget-missing": lambda args: print(json.dumps(forget_missing(*args))),
    "star": cmd_star, "favorites": lambda _: print(json.dumps(favorite_rows())),
    "open-favorite": lambda args: print(json.dumps(open_favorite(*args))),
    "ui-tab": cmd_ui_tab, "ui-restore": cmd_ui_restore,
    "review": cmd_review, "catalog": cmd_catalog, "tab-summary": cmd_tab_summary,
    "archive-confirmed": cmd_archive_confirmed, "restore-to": cmd_restore_to,
    "list": cmd_list, "preview": cmd_preview, "archive": cmd_archive,
    "restore": cmd_restore, "delete": cmd_delete, "go": cmd_go, "header": cmd_header, "ui": cmd_ui,
}


def main() -> None:
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd = argv[0] if argv else "ui"
    if cmd not in COMMANDS:
        sys.exit(f"unknown command {cmd!r}\n{__doc__}")
    try:
        COMMANDS[cmd](argv[1:])
    except RexError as e:
        status(f"error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
